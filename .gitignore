# --- Dev artifacts: local-only, never pushed to origin ---
docs/plans/
docs/superpowers/
.claude/

# --- Node (1inch deps resolve via npm) ---
node_modules/

# --- Frontend (Vite/Vitest/Playwright build + test artifacts) ---
/fe/dist
/fe/.vite
/fe/coverage
/fe/test-results
/fe/playwright-report

# --- Rust (backend, added later) ---
/backend/target
/target

# --- Foundry ---
/contracts/out
/contracts/cache
/contracts/broadcast

# --- env / secrets ---
.env
.env.*
!.env.example
*.log

# --- editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- proptest failure-seed artifacts (regenerable, not tracked) ---
proptest-regressions/

# local server config (copy from solvent.example.toml); solvent.<side>.toml are generated by the
# cross-chain deploy (scripts/src/deploy/config.ts)
/solvent.toml
/solvent.origin.toml
/solvent.destination.toml

# --- devnet: generated per-deploy from the manifest (untracked) ---
/devnet/generated/
/contracts/deployments/

# --- server runtime state (recreated on boot) ---
*.redb

