{
  "name": "@solvent/sdk",
  "version": "0.1.0",
  "description": "Client-side, non-custodial TypeScript SDK for Solvent: strategy construction, position calldata, and a typed API client.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsup": "^8",
    "vitest": "^3"
  }
}
