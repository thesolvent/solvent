# Solvent API origin. The devnet server binds here by default.
VITE_API_BASE_URL=http://127.0.0.1:8080

# Devnet faucet origin. Docker Compose publishes the faucet here.
VITE_FAUCET_BASE_URL=http://127.0.0.1:8081

# Public Privy application identifier. Never expose the Privy app secret to Vite.
VITE_PRIVY_APP_ID=

# Origin and destination networks available to Privy and wagmi.
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=EthDevnet
VITE_RPC_URL=http://127.0.0.1:9645
VITE_DESTINATION_CHAIN_ID=31338
VITE_DESTINATION_CHAIN_NAME=BaseDevnet
VITE_DESTINATION_RPC_URL=http://127.0.0.1:9646

# Cross-chain devnet services.
VITE_SOLVENTX_ORIGIN_API_URL=http://127.0.0.1:8399
VITE_SOLVENTX_BASE_API_URL=http://127.0.0.1:8400
VITE_SOLVENTX_DIRECT_API_URL=http://127.0.0.1:8401
VITE_SOLVENTX_PROXY_URL=/solventx-api
