# Solvent API (S2 backend, serves /v1/*)
VITE_API_BASE_URL=http://localhost:8080

# Devnet chain (anvil)
VITE_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337

# Devnet faucet service (crates/devnet, POST /faucet). Run it on a host port distinct from the API.
VITE_FAUCET_URL=http://localhost:8080

# WalletConnect Cloud project id (injected wallets work without a real id on devnet).
VITE_WALLETCONNECT_PROJECT_ID=solvent-devnet
